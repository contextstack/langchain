# --- Core Infrastructure (core Compose profile) ---
# Uses 5439 / 6389 by default to avoid colliding with local Postgres/Redis installs.
POSTGRES_PORT=5439
REDIS_PORT=6389
DATABASE_URL=postgresql://app_rw:app_rw_dev_password@127.0.0.1:5439/contextstack
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:5439/contextstack
REDIS_URL=redis://127.0.0.1:6389/0

# --- Auth & Internal MCP Tokens (dev-only defaults; override for any shared deployment) ---
JWT_SIGNING_SECRET=dev-only-jwt-secret-key-at-least-32-bytes-long
MCP_TOKEN_SECRET=dev-only-mcp-secret-key-at-least-32-bytes-long
MCP_INFRA_URL=http://127.0.0.1:8101/mcp
MCP_TICKETING_URL=http://127.0.0.1:8102/mcp

# --- Model Layer ---
# Use "mock" for $0 deterministic CI, tests, and drills; "gateway" for LiteLLM Proxy
MODEL_MODE=mock
LITELLM_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=sk-litellm-dev-master
# Tenant virtual keys (used when MODEL_MODE=gateway)
LITELLM_KEY_TENANT_ALPHA=sk-litellm-dev-master
LITELLM_KEY_TENANT_BETA=sk-litellm-dev-master

# Provider API keys (only needed when running LiteLLM with real models in --profile full)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Evidence Plane / Telemetry ---
# Modes: none | langfuse_otel | langfuse_callback | langsmith
TELEMETRY_BACKEND=none

# Self-hosted Langfuse v4 (used when TELEMETRY_BACKEND=langfuse_otel or langfuse_callback)
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-dev-local
LANGFUSE_SECRET_KEY=sk-lf-dev-local

# Commercial Seam: flip to LangSmith with zero code changes
# TELEMETRY_BACKEND=langsmith
# LANGSMITH_TRACING=true
# LANGSMITH_OTEL_ENABLED=true
# LANGSMITH_OTEL_ONLY=false
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
